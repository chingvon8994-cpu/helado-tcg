{
  "name": "helado-tcg",
  "private": true,
  "version": "0.1.0",
  "description": "Helado Region TCG — a digital trading card game built around original Fakemon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "sim": "vite-node scripts/simulate.ts",
    "art": "python3 -I scripts/art/build_art.py"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "5.5",
    "vite": "^5.4.21",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
