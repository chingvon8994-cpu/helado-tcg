{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api", "src/server", "src/engine", "src/cards", "src/ai", "src/economy"]
}
